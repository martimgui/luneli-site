---
/** O rodapé compacto das páginas internas: a marca, os links e o ano. */
import { LINKS_DO_RODAPE as LINKS } from '../lib/links-do-rodape'
---
<footer class="rodape-curto" aria-label="Rodapé da Luneli">
  <div class="in">
    <div>
      <a class="r-marca" href="/" aria-label="Luneli, início">Luneli</a>
      <nav aria-label="Rodapé">
        <ul class="r-links">{LINKS.map((item) => <li><a href={item.href}>{item.texto}</a></li>)}</ul>
      </nav>
    </div>
    <div class="r-fim"><span>© 2026 Luneli · Preços em definição. Nada é cobrado nesta versão.</span></div>
  </div>
</footer>
