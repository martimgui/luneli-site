---
/**
 * A casca de uma tela do Luneli: a barra do topo e o conteúdo. A barra segue a real (apps/web, Moldura):
 * a marca, as telas na ordem verdadeira (um subconjunto, com "Mais" para o que não cabe), e à direita quem entrou,
 * Ajuda e Sair. Nada de estado do caixa aqui: isso fica na tela Caixa.
 * A barra e o conteúdo ficam na janela (.pj), que pode recuar inteira (v3, C5: no passo 3 a expedição toda recua,
 * com a barra); o que entra por cima dela (o celular do entregador) vai no slot "sobre", fora da janela.
 */
interface Props {
  aba: 'pedido' | 'mesas' | 'cozinha' | 'expedicao' | 'caixa'
  /** O instante em que a tela fica parada fora do palco (as cópias estáticas). */
  estatico: number
  claro?: boolean
  /** Atributos da janela (barra + conteúdo), para o estado ligado à rolagem (data-cls). */
  janela?: Record<string, string>
}
const { aba, estatico, claro = false, janela = {} } = Astro.props
const { class: classeDaJanela, ...atributosDaJanela } = janela
const TELAS: [Props['aba'] | null, string][] = [
  ['pedido', 'Pedido'],
  [null, 'Clientes'],
  [null, 'Pedidos do dia'],
  ['mesas', 'Mesas'],
  ['expedicao', 'Expedição'],
  ['cozinha', 'Cozinha'],
  ['caixa', 'Caixa'],
]
---
<div class:list={['pdv', { claro }]} data-estatico={estatico} aria-hidden="true">
 <div class:list={['pj', classeDaJanela]} {...atributosDaJanela}>
  <div class="pb">
    <span class="pb-marca"><svg class="pb-lua" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M11.6 10.4A5.5 5.5 0 0 1 5.6 4.4c0-.9.2-1.8.6-2.5A6 6 0 1 0 14.1 9.8c-.7.4-1.6.6-2.5.6Z" fill="currentColor"/></svg>Luneli</span>
    <div class="pb-abas">
      {TELAS.map(([id, nome]) => <span class:list={{ at: id === aba }}>{nome}</span>)}
      <span>Mais</span>
    </div>
    <span class="pb-esp"></span>
    <span class="pb-pessoa"><span class="pb-av">A</span><span class="pb-nome">Ana Lima</span></span>
    <span class="pb-acao">Ajuda</span>
    <span class="pb-acao">Sair</span>
  </div>
  <div class="pc"><slot /></div>
 </div>
 <slot name="sobre" />
</div>
