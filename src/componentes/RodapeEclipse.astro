---
/**
 * O rodapé da página de início: a folha sobe como uma cortina e mostra a lua cheia com "Luneli" atravessando-a,
 * uma peça só: as letras são recortadas da luz (escuras sobre a lua, brancas fora dela) e, conforme a sombra da
 * Terra cobre a lua, ficam brancas por onde ela passa. O eclipse para antes do fim (ECLIPSE_FINAL em
 * scripts/vitrine/rodape.ts): no repouso sobra um crescente de luz que continua recortando o nome.
 * Tudo ligado à rolagem (scripts/vitrine/rodape.ts), que desenha a lua (scripts/vitrine/lua.ts) e dá o tamanho
 * da palavra; com movimento reduzido vira um bloco normal, já no fim. Sem script, fica a palavra sobre o anel.
 */
import { LINKS_DO_RODAPE as LINKS } from '../lib/links-do-rodape'
---
<div class="r-vao" id="rVao">
  <footer class="rodape" id="rodape" aria-label="Rodapé da Luneli">
    <div class="r-cham">
      <h2 class="serifa" id="rFrase">Casa cheia, conta conferida.</h2>
      <p class="r-sub" id="rSub">O primeiro mês não é cobrado e não pede cartão. Crie a conta e veja o pedido andar na sua casa.</p>
      <div class="r-acoes" id="rAcoes">
        <a class="btn um" href="/testar-gratis/">Testar grátis</a>
        <a class="r-planos" href="/planos/">ou veja os planos</a>
      </div>
    </div>
    <div class="r-cena">
      <svg class="r-svg" id="rSvg" viewBox="0 0 1000 560" aria-hidden="true">
        <defs>
          <clipPath id="rcLuz"><path id="rcCaminho" d=""/></clipPath>
        </defs>
        <g id="rCeu"></g>
        <circle class="r-semjs" cx="500" cy="280" r="250" fill="none" stroke="rgba(255,255,255,.6)" stroke-width="1.6"/>
        <text class="r-palavra" id="rPalavra" x="500" y="338" text-anchor="middle">Luneli</text>
        <g id="rLuz"></g>
        <text class="r-palavra r-recorte" id="rRecorte" x="500" y="338" text-anchor="middle" clip-path="url(#rcLuz)" visibility="hidden">Luneli</text>
      </svg>
    </div>
    <div class="r-pe" id="rPe">
      <nav aria-label="Rodapé">
        <ul class="r-links">{LINKS.map((item) => <li><a href={item.href}>{item.texto}</a></li>)}</ul>
      </nav>
      <div class="r-fim" id="rFim"><span>© 2026 Luneli · Preços em definição. Nada é cobrado nesta versão.</span><a class="r-topo" href="#conteudo" id="rTopo">Voltar ao topo</a></div>
    </div>
  </footer>
</div>

<script>
  import '../scripts/vitrine/rodape'
</script>
