---
/** 5. O PDV de dia: a tela de pedido no tema claro (porcelana), com o seletor Escuro/Claro que troca a tela na hora. */
import Moldura from '../telas/Moldura.astro'
import Pedido from '../telas/Pedido.astro'
---
<section class="secao dia" id="dia" aria-labelledby="dTit">
  <div class="sec-cab">
    <div>
      <h2 class="serifa revela" id="dTit">O PDV de dia.</h2>
      <div class="troca-tema revela" style="--i:1" role="group" aria-label="Tema e cor da tela">
        <span>Tema</span>
        <div class="seg-site"><button type="button" id="tEsc" aria-pressed="false">Escuro</button><button type="button" id="tCla" aria-pressed="true">Claro</button></div>
        <div class="dia-cores" role="group" aria-label="Cor de destaque da tela">
          <button type="button" class="dia-cor is-active" data-dia-cor="#F5A524" style="background:#F5A524" aria-label="Âmbar"></button>
          <button type="button" class="dia-cor" data-dia-cor="#FF6B57" style="background:#FF6B57" aria-label="Tomate"></button>
          <button type="button" class="dia-cor" data-dia-cor="#5AA9FF" style="background:#5AA9FF" aria-label="Azul"></button>
          <button type="button" class="dia-cor" data-dia-cor="#3DD6C6" style="background:#3DD6C6" aria-label="Turquesa"></button>
          <button type="button" class="dia-cor" data-dia-cor="#4FD58A" style="background:#4FD58A" aria-label="Verde"></button>
          <button type="button" class="dia-cor" data-dia-cor="#B08CFF" style="background:#B08CFF" aria-label="Roxo"></button>
          <button type="button" class="dia-cor" data-dia-cor="#FF7AB6" style="background:#FF7AB6" aria-label="Rosa"></button>
          <button type="button" class="dia-cor" data-dia-cor="#FF8A65" style="background:#FF8A65" aria-label="Coral"></button>
        </div>
      </div>
    </div>
    <p class="revela" style="--i:2">O escuro vem de fábrica. Para o caixa perto da janela ou o balcão do almoço, cada pessoa troca para o claro em Minha conta, e escolhe uma de 8 cores e o tamanho da letra, com o mesmo desenho e os mesmos atalhos. Quem aprendeu uma vez, sabe usar nos dois.</p>
  </div>
  <div class="sec-tela">
    <Moldura classe="m-dia" rotulo="A tela de pedido do Luneli no tema claro.">
      <Pedido instante={0.9} claro />
    </Moldura>
    <p class="legenda-tela"><b>Tela de pedido</b> · tema claro · as mesmas teclas e o mesmo desenho do escuro</p>
  </div>
</section>
