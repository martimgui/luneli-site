---
/**
 * "Criar conta": cria a conta pessoal primeiro (Nome, Telefone com DDD, E-mail e Senha).
 * Depois de criar, a pessoa entra no Portal (/minha-conta/portal/) e escolhe se quer
 * criar o próprio restaurante (com CPF/CNPJ e teste grátis) ou aceitar um convite de uma loja.
 */
import CartaoDaConta from '../componentes/CartaoDaConta.astro'
import Campo from '../componentes/Campo.astro'
import { lunar } from '../componentes/telas/estado'

const DEPOIS = [
  'Você entra no Portal Luneli com seu e-mail e senha.',
  'Escolhe se quer criar o seu restaurante (1º teste grátis por CPF/CNPJ) ou aceitar o convite de uma loja.',
  'Se já trabalha em mais de uma pizzaria, gerencia tudo pela mesma conta.',
]
const GANHOS = [
  { titulo: 'Uma conta única para tudo', texto: 'Serve para dono, gerente, caixa, garçom ou motoboy — sem criar um login diferente por loja.' },
  { titulo: 'Primeiro teste sem cartão', texto: 'Ao criar seu restaurante no Portal, você ganha o período grátis sem pedir cartão.' },
  { titulo: 'Convites direto no Portal', texto: 'Se você foi convidado por uma loja, o convite aparece pronto para aceitar assim que entrar.' },
]
---
<CartaoDaConta titulo="Criar conta" descricao="Crie sua conta pessoal no Luneli para abrir seu restaurante ou entrar em uma equipe.">
  <Fragment slot="lado">
    <h1 id="h-pagina" class="lado-titulo">Uma conta para o seu restaurante ou para a sua equipe.</h1>
    <p class="lado-resumo">Crie sua conta pessoal em segundos. Depois você escolhe se vai abrir uma loja ou aceitar um convite.</p>
    <ul class="lado-lista">
      {GANHOS.map((ganho, i) => (
        <li><span class="lado-fz" aria-hidden="true"><Fragment set:html={lunar(0.66 * (i + 1), 16)} /></span><span><b>{ganho.titulo}</b>{ganho.texto}</span></li>
      ))}
    </ul>
  </Fragment>
  <div id="etapa-formulario">
    <p class="cartao-rotulo" id="h-cartao">Sua conta pessoal</p>
    <p class="fraco">Depois de criar, você escolhe se quer abrir um restaurante ou entrar em um existente.</p>
    <p class="aviso aviso-info" id="aviso-config" hidden></p>
    <form id="form-criar" class="form" method="post" novalidate aria-labelledby="h-cartao">
      <fieldset class="grupo">
        <legend>Seus dados</legend>
        <div class="grupo-campos">
          <div class="linha-2">
            <Campo nome="nome" rotulo="Seu nome" autocomplete="name" obrigatorio maximo={80} />
            <Campo nome="telefone" rotulo="Telefone com DDD" tipo="tel" autocomplete="tel" inputmode="tel" obrigatorio maximo={40} placeholder="(11) 98765-4321" />
          </div>
          <Campo nome="email" rotulo="E-mail" tipo="email" autocomplete="email" inputmode="email" obrigatorio nota="É com ele que você entra no Portal e recebe convites." />
          <Campo nome="senha" rotulo="Senha" tipo="password" autocomplete="new-password" obrigatorio nota="Pelo menos 8 caracteres." mostrar />
        </div>
      </fieldset>
      <p class="aviso" role="alert" hidden></p>
      <div class="acoes">
        <button class="btn um" type="submit">Criar minha conta</button>
        <span class="acoes-termos"><a class="ligacao" href="/termos/">Termos</a> e <a class="ligacao" href="/privacidade/">Privacidade</a></span>
        <a class="ligacao" href="/entrar/">Já tenho conta</a>
      </div>
    </form>
  </div>
  <Fragment slot="depois">
    <h2 class="depois-titulo" id="h-depois">Depois de criar a conta</h2>
    <ol class="depois-lista" aria-labelledby="h-depois">
      {DEPOIS.map((passo, i) => <li><span class="depois-n" aria-hidden="true">{i + 1}</span><span>{passo}</span></li>)}
    </ol>
  </Fragment>
  <script>
    import '../scripts/conta/testar-gratis'
  </script>
</CartaoDaConta>
