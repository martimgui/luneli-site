---
import Base from '../layouts/Base.astro'
import { ENDERECO_DO_SISTEMA } from '../lib/conta'
import { funcaoDoSite } from '@pdv/core'
import Marca from '../componentes/Marca.astro'
const caixa = funcaoDoSite('caixa_para_windows')
const lojas = funcaoDoSite('apps_nas_lojas')
const impressora = funcaoDoSite('programa_da_impressora')
---
<Base titulo="Baixar | Luneli" descricao="Ainda não há programa para baixar: o Luneli abre no navegador do computador, e o entregador usa uma página no celular.">
  <section class="pagina" aria-labelledby="h-pagina">
    <div class="in">
      <h1 id="h-pagina">Baixar</h1>
      <p class="lead">Ainda não há programa para baixar: o caixa para Windows está sendo feito. Por enquanto, o Luneli abre no navegador do computador, e o entregador usa uma página no celular, ligada à loja com um código.</p>
      <div class="blocos">
        <article class="bloco agora">
          <h2>Hoje: no navegador</h2>
          <p>O caixa abre no navegador do computador do balcão, com o <span class="sem-quebra">e-mail</span> e a senha da sua conta. Para vender, nada para instalar.</p>
          {ENDERECO_DO_SISTEMA !== '' ? (
            <a class="btn um" href={ENDERECO_DO_SISTEMA}>Abrir o sistema</a>
          ) : (
            <a class="btn um" href="/testar-gratis/">Começar grátis</a>
          )}
        </article>
        <article class="bloco">
          <h2>Caixa para Windows</h2>
          <p>O programa do caixa instalado no computador do restaurante, sem navegador. O instalador ainda está sendo feito.</p>
          <Marca funcao={caixa} />
        </article>
        <article class="bloco">
          <h2>Apps nas lojas</h2>
          <p>O app do entregador e o do garçom na Google Play e na App Store. Hoje o entregador usa a página Luneli Entregador no navegador do celular.</p>
          <Marca funcao={lojas} />
        </article>
        <article class="bloco">
          <h2>Comanda em papel</h2>
          <p>O programa que liga o computador do balcão à impressora, para a comanda sair no papel. Ainda está sendo preparado para baixar.</p>
          <Marca funcao={impressora} />
        </article>
      </div>
      <div class="acoes acoes-fim">
        <a class="btn um" href="/testar-gratis/">Testar grátis</a>
        <a class="ligacao" href="/o-que-vem-por-ai/">Veja o que vem por aí</a>
      </div>
    </div>
  </section>
</Base>
